{
  "extends": "@phanect/configs/ts",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "moduleDetection": "force",
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "./**/*.js",
    "./**/*.mjs",
    "./**/*.cjs",
    "./**/*.ts",
    "./**/*.mts",
    "./**/*.cts",
    "./**/*.jsx",
    "./**/*.tsx"
  ]
}
